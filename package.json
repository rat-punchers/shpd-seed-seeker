{
  "name": "shpd-seed-seeker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "web-v2",
    "packages/*",
    "tooling/web-*"
  ],
  "scripts": {
    "check": "biome check",
    "check:fix": "biome check --fix",
    "check:types": "tsc -b",
    "build": "bun run --filter '*' --if-present build",
    "test": "bun run --filter '*' --if-present test",
    "dev": "conc -k --kill-timeout 3000 'bun:dev:*'",
    "design": "bun run --filter '@seed-seeker/design' dev",
    "build:wasm": "./scripts/build-web-wasm.sh web-v2",
    "dev:web-v2": "bun run --filter '@seed-seeker/web-v2' dev",
    "test:visual": "bun run build && bun run test:visual:only",
    "test:visual:only": "bun run --cwd tooling/web-visual test:visual",
    "test:visual:update": "bun run build && bun run --cwd tooling/web-visual test:visual:update",
    "install:visual-browser": "bun run --cwd tooling/web-visual install:browser",
    "deploy:setup": "bun tooling/web-deploy/setup-credentials.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "concurrently": "10.0.6",
    "typescript": "7.0.2"
  }
}
